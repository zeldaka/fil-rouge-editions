# Copier ce fichier en ".env" et renseigner la vraie clé.
# Clé API Resend (https://resend.com) — nécessaire pour que le formulaire
# de contact envoie réellement un e-mail. Sans elle, le formulaire affiche
# un message d'erreur au lieu d'envoyer.
RESEND_API_KEY=

# Instagram Graph API — nécessaire pour le carrousel de posts en direct
# (À propos + Contact). Sans ces deux valeurs, le carrousel affiche un
# message d'attente au lieu de planter. Voir README pour la marche à suivre.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
