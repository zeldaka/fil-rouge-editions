---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import InstagramBubble from '../components/InstagramBubble.astro';
import { Font, getImage } from 'astro:assets';
import audreyPartage from '../assets/audrey-klein-partage.jpg';
import '../styles/global.css';

interface Props {
  /** Titre complet de la page (balise <title>), marque comprise — aucun
   * suffixe n'est ajouté, pour garder la main sur les mots-clés et la longueur
   * (≈ 60 caractères max avant troncature dans Google). */
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Image utilisée pour l'aperçu quand une page est partagée (réseaux
// sociaux, WhatsApp, etc.) — format standard 1200×630. Fichier dédié,
// recadré à la main dans audrey-klein.png : un recadrage automatique au
// centre coupait le haut du visage.
const ogImage = await getImage({ src: audreyPartage, width: 1200, height: 630, format: 'jpg' });
const ogImageURL = new URL(ogImage.src, Astro.site);

// Données structurées (schema.org) : "Person" (Audrey) et "Organization"
// (Klein Éditions, la marque) — volontairement pas
// "LocalBusiness"/"ProfessionalService", qui impliquerait une zone
// géographique, contrairement au brief. Uniquement des informations
// réelles, aucune inventée.
const siteURL = new URL('/', Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteURL}#audrey-klein`,
      name: 'Audrey Klein',
      jobTitle: 'Biographe personnelle & familiale',
      url: siteURL,
      image: ogImageURL.toString(),
      email: 'mailto:contact@klein-editions.com',
      knowsLanguage: ['fr', 'en', 'es'],
      worksFor: { '@id': `${siteURL}#klein-editions` },
      sameAs: ['https://instagram.com/books_njoy', 'https://www.booksnjoy.com/'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteURL}#klein-editions`,
      name: 'Klein Éditions',
      url: siteURL,
      email: 'mailto:contact@klein-editions.com',
      founder: { '@id': `${siteURL}#audrey-klein` },
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Klein Éditions" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {/* Polices auto-hébergées (voir astro.config.mjs). Seul le texte courant
        (Quicksand) est préchargé : précharger aussi Lora retardait la photo
        de l'accueil (LCP ≈ +0,6 s sur mobile). */}
    <Font cssVariable="--font-quicksand" preload />
    <Font cssVariable="--font-lora" />
    <Font cssVariable="--font-poppins" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppBubble />
    <InstagramBubble />

    <script>
      // Le fil rouge se dessine très légèrement au scroll — effet discret,
      // jamais spectaculaire, désactivé si l'utilisateur préfère moins
      // d'animations. Sans JavaScript, le trait reste simplement visible.
      function initHandThreads() {
        const threads = document.querySelectorAll<HTMLElement>('.hand-thread');
        if (threads.length === 0) return;

        // Navigateurs récents : le fil suit le défilement, entièrement en CSS
        // (voir Thread.astro). Ce script ne sert plus que d'alternative.
        if (CSS.supports('animation-timeline: view()')) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) return;

        // Le ruban est une forme pleine (fill), pas un trait : on le révèle
        // du haut vers le bas avec un clip-path plutôt qu'un stroke-dashoffset
        // (qui ne s'applique qu'à un contour dessiné, pas à un remplissage).
        //
        // On observe le PARENT (jamais clippé), pas le SVG lui-même : un
        // élément déjà réduit à 0 par clip-path est mesuré par
        // IntersectionObserver comme non-intersectant, ce qui bloquerait
        // la révélation avant même qu'elle commence.
        threads.forEach((thread) => {
          thread.style.clipPath = 'inset(0 0 100% 0)';
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const parent = entry.target as HTMLElement;
                const target = parent.querySelector<HTMLElement>('.hand-thread');
                if (target) {
                  target.style.transition = 'clip-path 2.6s ease-out';
                  target.style.clipPath = 'inset(0 0 0% 0)';
                }
                observer.unobserve(parent);
              }
            });
          },
          { threshold: 0.01 }
        );

        threads.forEach((thread) => {
          const parent = thread.parentElement;
          if (parent) observer.observe(parent);
        });
      }

      // Apparition douce au défilement des éléments marqués data-reveal
      // (cartes, étapes, couvertures…). Seuls ceux encore sous le bas de
      // l'écran au chargement sont masqués : rien de déjà visible ne
      // disparaît, et sans JavaScript tout reste affiché normalement.
      function initReveal() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) return;

        const pending = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]')).filter(
          (el) => el.getBoundingClientRect().top > window.innerHeight
        );
        if (pending.length === 0) return;

        pending.forEach((el) => el.classList.add('reveal'));

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              observer.unobserve(el);
              el.classList.add('reveal--visible');
              // Une fois arrivé, l'élément retrouve ses styles normaux (sinon
              // son délai d'apparition ralentirait aussi ses effets de survol).
              el.addEventListener('transitionend', () => el.classList.remove('reveal', 'reveal--visible'), {
                once: true,
              });
            });
          },
          { rootMargin: '0px 0px -10% 0px' }
        );

        pending.forEach((el) => observer.observe(el));
      }

      function initAnimations() {
        initHandThreads();
        initReveal();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAnimations);
      } else {
        initAnimations();
      }
    </script>
  </body>
</html>
