---
const mainNav = [
  { href: '/a-propos/', label: 'À propos', color: 'var(--accent-a-propos)' },
  { href: '/vos-histoires/', label: 'Vos histoires', color: 'var(--accent-vos-histoires)' },
  { href: '/les-etapes/', label: 'Les étapes', color: 'var(--accent-les-etapes)' },
  { href: '/critiques-litteraires/', label: "Books'nJoy", color: 'var(--accent-critiques)' },
];
const contactItem = { href: '/contact/', label: 'Contact', color: 'var(--accent-contact)' };

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a href="/" class="site-header__brand">Klein Éditions</a>

    <button class="site-header__toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Ouvrir le menu</span>
      <span class="site-header__toggle-bar"></span>
      <span class="site-header__toggle-bar"></span>
      <span class="site-header__toggle-bar"></span>
    </button>

    <nav id="site-nav" class="site-header__nav">
      <div class="site-header__nav-main">
        {mainNav.map((item) => (
          <a
            href={item.href}
            class:list={['site-header__link', { 'is-active': currentPath === item.href }]}
            style={`--link-color: ${item.color};`}
          >
            {item.label}
          </a>
        ))}
      </div>
      <a
        href={contactItem.href}
        class:list={['site-header__link', 'site-header__nav-contact', { 'is-active': currentPath === contactItem.href }]}
        style={`--link-color: ${contactItem.color};`}
      >
        {contactItem.label}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-card-border);
    position: sticky;
    top: 0;
    z-index: 40;
    /* Reste immobile pendant le fondu entre les pages (voir global.css). */
    view-transition-name: site-header;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 18px 24px;
    gap: clamp(32px, 6vw, 64px);
  }

  .site-header__brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
  }

  .site-header__nav-main {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    gap: 28px;
    flex-wrap: wrap;
  }

  .site-header__nav-contact {
    margin-left: 28px;
    white-space: nowrap;
  }

  .site-header__link {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-ink);
    padding-bottom: 5px;
    /* Trait de soulignement à la couleur de la rubrique, qui se déploie de
       gauche à droite au survol (et reste affiché sur la page active). */
    background: linear-gradient(var(--link-color, var(--accent-accueil)), var(--link-color, var(--accent-accueil)))
      left bottom / 0% 2px no-repeat;
  }

  .site-header__link.is-active,
  .site-header__link:hover {
    background-size: 100% 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__link {
      transition: background-size 0.3s ease;
    }
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    margin-left: auto;
  }

  .site-header__toggle-bar {
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    display: block;
  }

  @media (max-width: 860px) {
    .site-header__toggle {
      display: flex;
    }

    /* Menu fermé : masqué mais toujours en place, pour pouvoir animer son
       ouverture (visibility le retire aussi du clavier et des lecteurs
       d'écran). */
    .site-header__nav {
      display: flex;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-card-border);
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 12px 24px 20px;
    }

    .site-header__nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .site-header__nav-main {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      width: 100%;
      gap: 4px;
    }

    .site-header__nav-contact {
      margin-left: 0;
    }

    .site-header__link {
      padding: 10px 0;
      width: 100%;
    }
  }

  @media (max-width: 860px) and (prefers-reduced-motion: no-preference) {
    /* visibility attend la fin du fondu à la fermeture, s'applique tout de
       suite à l'ouverture. */
    .site-header__nav {
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
    }

    .site-header__nav.is-open {
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s;
    }

    .site-header__toggle-bar {
      transition: transform 0.25s ease, opacity 0.2s ease;
    }
  }

  /* Burger → croix quand le menu est ouvert. Le 1er enfant du bouton est
     le texte masqué, d'où les barres en nth-child 2 à 4 (5px d'écart + 2px
     d'épaisseur = 7px de décalage). */
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(3) {
    opacity: 0;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    // Le bouton affiche une croix une fois ouvert : son libellé suit.
    const label = toggle.querySelector('.visually-hidden');
    if (label) label.textContent = isOpen ? 'Fermer le menu' : 'Ouvrir le menu';
  });
</script>
