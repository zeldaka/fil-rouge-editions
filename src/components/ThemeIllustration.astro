---
// Petites illustrations par thématique de "Conseils de lecture" — cercles et
// traits, dans le même esprit graphique que le fil rouge dessiné à la main,
// plutôt que des illustrations figuratives complexes.
interface Props {
  slug: string;
  color: string;
}
const { slug, color } = Astro.props;
---

{slug === 'sagas-familiales' && (
  <svg viewBox="0 0 90 90" fill="none" aria-hidden="true">
    <path d="M45,29 L20,46 M45,29 L70,46 M20,64 L12,73 M20,64 L32,73 M70,64 L60,73 M70,64 L80,73"
      stroke={color} stroke-width="2.5" stroke-linecap="round" />
    <circle cx="45" cy="20" r="9" fill={color} />
    <circle cx="20" cy="55" r="9" fill={color} opacity="0.75" />
    <circle cx="70" cy="55" r="9" fill={color} opacity="0.75" />
    <circle cx="12" cy="80" r="7" fill={color} opacity="0.5" />
    <circle cx="32" cy="80" r="7" fill={color} opacity="0.5" />
    <circle cx="60" cy="80" r="7" fill={color} opacity="0.5" />
    <circle cx="80" cy="80" r="7" fill={color} opacity="0.5" />
  </svg>
)}

{slug === 'recits-de-filiation' && (
  <svg viewBox="0 0 90 90" fill="none" aria-hidden="true">
    <path d="M45,27 L45,38 M45,54 L45,64" stroke={color} stroke-width="2.5" stroke-linecap="round" />
    <circle cx="45" cy="18" r="9" fill={color} />
    <circle cx="45" cy="46" r="7.5" fill={color} opacity="0.75" />
    <circle cx="45" cy="71" r="6" fill={color} opacity="0.5" />
    <circle cx="45" cy="84" r="2" fill={color} opacity="0.3" />
  </svg>
)}

{slug === 'parcours-de-vie' && (
  <svg viewBox="0 0 90 90" fill="none" aria-hidden="true">
    <path d="M15,78 C25,70 28,65 35,60 C45,53 50,48 58,42 C66,36 70,28 78,20"
      stroke={color} stroke-width="2.5" stroke-linecap="round" />
    <circle cx="15" cy="78" r="4" fill={color} opacity="0.5" />
    <circle cx="35" cy="60" r="5.5" fill={color} opacity="0.65" />
    <circle cx="58" cy="42" r="7" fill={color} opacity="0.8" />
    <circle cx="78" cy="20" r="9" fill={color} />
  </svg>
)}

{slug === 'exils-et-racines' && (
  <svg viewBox="0 0 90 90" fill="none" aria-hidden="true">
    <path d="M32,48 C26,56 22,60 16,64 M32,48 C30,58 29,64 27,72 M32,48 C36,58 37,64 38,74"
      stroke={color} stroke-width="2.2" stroke-linecap="round" opacity="0.6" />
    <path d="M38,42 C50,34 60,28 70,20" stroke={color} stroke-width="2.5" stroke-linecap="round" />
    <circle cx="32" cy="48" r="9" fill={color} />
    <circle cx="70" cy="20" r="6.5" fill={color} opacity="0.75" />
  </svg>
)}

{slug === 'la-grande-histoire' && (
  <svg viewBox="0 0 90 90" fill="none" aria-hidden="true">
    <circle cx="45" cy="48" r="29" stroke={color} stroke-width="2.2" opacity="0.5" />
    <circle cx="35" cy="40" r="5.5" fill={color} opacity="0.75" />
    <circle cx="56" cy="45" r="5.5" fill={color} opacity="0.75" />
    <circle cx="45" cy="62" r="5.5" fill={color} opacity="0.75" />
  </svg>
)}

{slug === 'famille-tous-etats' && (
  <svg viewBox="0 0 90 90" fill="none" aria-hidden="true">
    <circle cx="36" cy="38" r="17" fill={color} opacity="0.45" />
    <circle cx="56" cy="38" r="17" fill={color} opacity="0.45" />
    <circle cx="46" cy="56" r="17" fill={color} opacity="0.45" />
  </svg>
)}
