---
// Flux Instagram chargé côté client (fetch vers /api/instagram-feed) : la
// page qui l'utilise reste statique et rapide, le flux se remplit après le
// chargement. Le bloc reste masqué tant que le flux ne renvoie aucune
// publication (jeton absent ou expiré, erreur réseau) : pas de texte
// d'attente visible des visiteurs ni indexé par Google. Le conteneur qui
// l'entoure peut porter data-instagram-wrap pour être masqué avec lui
// (voir global.css).
import InstagramIcon from './InstagramIcon.astro';
import { siteConfig } from '../data/config';

interface Props {
  compact?: boolean;
  hideHeader?: boolean;
  limit?: number;
  showMoreLink?: boolean;
  /** Bord à bord, largeur totale disponible, pas de défilement : le nombre
   * de vignettes visibles s'adapte à la largeur de l'écran. */
  fill?: boolean;
}
const {
  compact = false,
  hideHeader = false,
  limit = 8,
  showMoreLink = false,
  fill = false,
} = Astro.props;

const profileUrl = siteConfig.instagramHandle
  ? `https://instagram.com/${siteConfig.instagramHandle.replace('@', '')}`
  : undefined;

const uid = `ig-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['instagram', { 'instagram--compact': compact, 'instagram--fill': fill }]}
  data-instagram-root
  data-limit={limit}
  data-show-more={showMoreLink && profileUrl ? 'true' : 'false'}
  data-profile-url={profileUrl}
  data-fill={fill ? 'true' : 'false'}
  data-tile-target={compact ? 110 : 170}
  id={uid}
  hidden
>
  {!hideHeader && (
    <div class="instagram__header">
      <InstagramIcon size={compact ? 18 : 22} />
      <p class="eyebrow">Instagram</p>
      {profileUrl && (
        <a class="instagram__handle" href={profileUrl} target="_blank" rel="noopener noreferrer">
          {siteConfig.instagramHandle}
        </a>
      )}
    </div>
  )}

  <div class="instagram__scroller" data-instagram-scroller></div>
</div>

<style>
  .instagram {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .instagram[hidden] {
    display: none;
  }

  .instagram__header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .instagram__handle {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .instagram__handle:hover {
    text-decoration: underline;
  }

  .instagram__scroller {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 4px;
  }

  .instagram__scroller :global(a.instagram__tile) {
    flex: 0 0 auto;
    width: 160px;
    height: 160px;
    border-radius: 14px;
    overflow: hidden;
    scroll-snap-align: start;
    display: block;
    position: relative;
  }

  .instagram--compact .instagram__scroller :global(a.instagram__tile) {
    width: 110px;
    height: 110px;
    border-radius: 10px;
  }

  .instagram__scroller :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .instagram__scroller :global(img) {
      transition: transform 0.4s ease;
    }

    .instagram__scroller :global(a.instagram__tile:hover img) {
      transform: scale(1.06);
    }
  }

  /* Mode "fill" : les vignettes se répartissent bord à bord sur toute la
     largeur disponible, sans défilement — leur nombre est calculé côté
     script en fonction de la largeur de l'écran (voir <script> plus bas). */
  .instagram--fill .instagram__scroller {
    overflow: visible;
  }

  .instagram--fill .instagram__scroller :global(a.instagram__tile) {
    flex: 1 1 0;
    width: auto;
    aspect-ratio: 1 / 1;
    height: auto;
  }

  .instagram__scroller :global(a.instagram__more) {
    flex: 0 0 auto;
    width: 160px;
    height: 160px;
    border-radius: 14px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    background: var(--color-card-bg, rgba(0, 0, 0, 0.03));
    border: 1px solid var(--color-card-border, rgba(0, 0, 0, 0.1));
    color: var(--color-ink, inherit);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    padding: 12px;
  }

  .instagram--compact .instagram__scroller :global(a.instagram__more) {
    width: 110px;
    height: 110px;
    font-size: 0.75rem;
    padding: 8px;
    gap: 4px;
  }

  .instagram--fill .instagram__scroller :global(a.instagram__more) {
    flex: 1 1 0;
    width: auto;
    aspect-ratio: 1 / 1;
    height: auto;
    border-radius: 14px;
  }

  .instagram__scroller :global(a.instagram__more:hover) {
    opacity: 0.85;
  }
</style>

<script>
  function computeFillCount(container: HTMLElement, targetTile: number, gap: number, max: number): number {
    const width = container.getBoundingClientRect().width || targetTile * 3;
    const count = Math.round((width + gap) / (targetTile + gap));
    return Math.max(2, Math.min(max, count));
  }

  async function initInstagramCarousels() {
    const roots = document.querySelectorAll<HTMLElement>('[data-instagram-root]');
    if (roots.length === 0) return;

    let posts: Array<{ id: string; permalink: string; imageUrl: string; caption?: string }> | null = null;

    try {
      const res = await fetch('/api/instagram-feed/');
      if (res.ok) {
        const data = await res.json();
        posts = data.posts ?? [];
      }
    } catch {
      posts = null;
    }

    roots.forEach((root) => {
      const scroller = root.querySelector<HTMLElement>('[data-instagram-scroller]');
      if (!scroller) return;

      if (!posts || posts.length === 0) return;
      root.hidden = false;

      const maxLimit = Number(root.dataset.limit ?? '8') || 8;
      const showMore = root.dataset.showMore === 'true';
      const profileUrl = root.dataset.profileUrl;
      const isFill = root.dataset.fill === 'true';
      const targetTile = Number(root.dataset.tileTarget ?? '170') || 170;

      const render = () => {
        let count = maxLimit;
        if (isFill) {
          count = computeFillCount(root, targetTile, 12, maxLimit);
          if (showMore && profileUrl) count = Math.max(2, count - 1);
        }
        const visible = posts!.slice(0, count);

        scroller.innerHTML = '';
        visible.forEach((post) => {
          const a = document.createElement('a');
          a.href = post.permalink;
          a.className = 'instagram__tile';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.setAttribute('aria-label', post.caption ? post.caption.slice(0, 80) : 'Voir la publication sur Instagram');
          const img = document.createElement('img');
          img.src = post.imageUrl;
          img.loading = 'lazy';
          img.alt = '';
          a.appendChild(img);
          scroller.appendChild(a);
        });

        if (showMore && profileUrl) {
          const more = document.createElement('a');
          more.href = profileUrl;
          more.className = 'instagram__more';
          more.target = '_blank';
          more.rel = 'noopener noreferrer';
          more.textContent = 'Voir plus →';
          scroller.appendChild(more);
        }
      };

      render();

      if (isFill) {
        let resizeTimer: ReturnType<typeof setTimeout>;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(render, 150);
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstagramCarousels);
  } else {
    initInstagramCarousels();
  }
</script>
