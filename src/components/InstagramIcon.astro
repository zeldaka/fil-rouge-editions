---
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className = '' } = Astro.props;
const gid = `ig-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gid} x1="2" y1="30" x2="30" y2="2" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#FEE411" />
      <stop offset="0.3" stop-color="#F9722D" />
      <stop offset="0.6" stop-color="#D6259A" />
      <stop offset="1" stop-color="#6B3BD8" />
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="28" height="28" rx="8" fill={`url(#${gid})`} />
  <rect x="9" y="9" width="14" height="14" rx="5" stroke="#fff" stroke-width="2" fill="none" />
  <circle cx="16" cy="16" r="3.6" stroke="#fff" stroke-width="2" fill="none" />
  <circle cx="23.2" cy="8.8" r="1.3" fill="#fff" />
</svg>
