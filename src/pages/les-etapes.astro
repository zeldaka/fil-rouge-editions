---
import Layout from '../layouts/Layout.astro';
import Thread from '../components/Thread.astro';
import { etapes } from '../data/etapes';
---

<Layout
  title="Écrire sa biographie : les 8 étapes · Klein Éditions"
  description="Les huit étapes pour écrire votre biographie ou votre récit de vie : entretiens, rédaction, relectures, photographies, jusqu'à l'impression du livre."
>
  <section class="section etapes">
    <div class="etapes__thread">
      <Thread variant="b" color="var(--accent-les-etapes)" />
    </div>
    <div class="container etapes__layout">
      <h1>Les étapes</h1>

      <ol class="etapes__list" data-etapes>
        {etapes.map((etape) => (
          <li class="etapes__item" data-reveal>
            <span class="etapes__numero">{etape.numero}</span>
            <div>
              <h3>{etape.titre}</h3>
              <p>{etape.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <a class="btn btn-primary etapes__cta" href="/contact/" data-reveal>Parlons de votre histoire</a>
    </div>
  </section>
</Layout>

<style>
  .etapes {
    position: relative;
    overflow: hidden;
    overflow: clip; /* pas « hidden » seul : voir Thread.astro */
  }

  .etapes__thread {
    position: absolute;
    inset: 10px 0;
    opacity: 0.55;
    z-index: 0;
  }

  .etapes__layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Frise : les numéros sont des pastilles reliées par un fil vertical.
     Avec le script ci-dessous (et sans « Réduire les animations »), le fil
     se remplit au défilement, de la 1re pastille (haut de page) à la
     dernière (bas de page) ; sinon, la frise s'affiche complète. */
  .etapes__list {
    --pastille: 44px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 620px;
    position: relative;
  }

  .etapes__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--pastille) 1fr;
    column-gap: 20px;
    align-items: start;
  }

  /* Segment de fil d'une pastille à la suivante : piste pâle (::before) et
     remplissage (::after), dont --remplissage (0 → 1) est réglé au défilement. */
  .etapes__item:not(:last-child)::before,
  .etapes__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--pastille) / 2 - 1px);
    top: calc(var(--pastille) / 2);
    width: 2px;
    height: calc(100% + var(--space-4));
  }

  .etapes__item::before {
    background: color-mix(in srgb, var(--accent-les-etapes) 30%, transparent);
  }

  .etapes__item::after {
    background: var(--accent-les-etapes);
    transform-origin: top;
    transform: scaleY(var(--remplissage, 1));
  }

  .etapes__item > div {
    padding-top: 9px;
  }

  .etapes__item h3 {
    margin-bottom: 6px;
  }

  .etapes__item p {
    color: var(--color-ink-muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .etapes__numero {
    position: relative;
    z-index: 1;
    width: var(--pastille);
    height: var(--pastille);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--accent-les-etapes);
    background: var(--accent-les-etapes);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .etapes__list--progressive .etapes__item:not(.is-reached) .etapes__numero {
    background: var(--color-bg);
    color: var(--color-ink-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .etapes__numero {
      transition: background-color 0.4s ease, color 0.4s ease;
    }

    .etapes__list--progressive .etapes__item.is-reached .etapes__numero {
      animation: pastille-allumee 0.45s ease-out;
    }
  }

  @keyframes pastille-allumee {
    50% {
      transform: scale(1.12);
    }
  }

  @media (max-width: 640px) {
    .etapes__list {
      --pastille: 38px;
    }

    .etapes__item > div {
      padding-top: 6px;
    }
  }

  .etapes__cta {
    align-self: flex-start;
  }

</style>

<script>
  // Frise : un « curseur » avance le long du fil au rythme du défilement de
  // la page — sur la 1re pastille tout en haut, sur la dernière tout en bas,
  // quelle que soit la taille de l'écran. Le fil se remplit jusqu'à lui et
  // chaque pastille s'allume quand il l'atteint.
  const liste = document.querySelector<HTMLElement>('[data-etapes]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (liste && !reduceMotion) {
    const items = Array.from(liste.querySelectorAll<HTMLElement>('.etapes__item'));
    let planifie = false;

    // Position du centre d'une pastille dans l'écran. offsetTop ignore le
    // décalage de l'animation d'apparition (transform) des étapes.
    const centre = (item: HTMLElement, haut: number) => {
      const numero = item.querySelector<HTMLElement>('.etapes__numero');
      return haut + item.offsetTop + (numero ? numero.offsetTop + numero.offsetHeight / 2 : 0);
    };

    const actualiser = () => {
      planifie = false;
      const haut = liste.getBoundingClientRect().top;
      const centres = items.map((item) => centre(item, haut));
      const defilementMax = document.documentElement.scrollHeight - window.innerHeight;
      const progression = defilementMax > 0 ? Math.min(1, Math.max(0, window.scrollY / defilementMax)) : 1;
      const curseur = centres[0] + progression * (centres[centres.length - 1] - centres[0]);

      items.forEach((item, i) => {
        item.classList.toggle('is-reached', centres[i] <= curseur + 0.5);
        if (i < items.length - 1) {
          const remplissage = (curseur - centres[i]) / (centres[i + 1] - centres[i]);
          item.style.setProperty('--remplissage', Math.min(1, Math.max(0, remplissage)).toFixed(3));
        }
      });
    };

    const planifier = () => {
      if (planifie) return;
      planifie = true;
      requestAnimationFrame(actualiser);
    };

    liste.classList.add('etapes__list--progressive');
    actualiser();
    window.addEventListener('scroll', planifier, { passive: true });
    window.addEventListener('resize', planifier);
  }
</script>
