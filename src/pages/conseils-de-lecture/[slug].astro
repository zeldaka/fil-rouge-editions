---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { thematiques } from '../../data/livres';
import { illustrations } from '../../data/illustrations';

export function getStaticPaths() {
  return thematiques.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

const { theme } = Astro.props;
---

<Layout
  title={`Conseils de lecture · ${theme.titre}`}
  description={`Une sélection de livres sur le thème "${theme.titre}", par Audrey Klein (Books'nJoy).`}
>
  <section class="section theme">
    <div class="container">
      <a class="theme__back" href="/critiques-litteraires/">← Conseils de lecture</a>

      <div class="theme__banner">
        <Image src={illustrations[theme.slug]} alt="" width={1260} height={420} />
      </div>

      <div class="theme__header">
        <h1>{theme.titre}</h1>
      </div>

      {theme.livres.length === 0 ? (
        <p class="theme__empty">Sélection à venir.</p>
      ) : (
        <div class="theme__grid">
          {theme.livres.map((livre) => {
            const Wrapper = livre.lien ? 'a' : 'div';
            const wrapperProps = livre.lien
              ? { href: livre.lien, target: '_blank', rel: 'noopener noreferrer' }
              : {};
            return (
              <Wrapper class="theme__book" {...wrapperProps}>
                {livre.couverture && (
                  <Image
                    src={livre.couverture}
                    alt={`Couverture de ${livre.titre}`}
                    width={240}
                    height={360}
                    class="theme__cover"
                  />
                )}
                <p class="theme__book-titre">{livre.titre}</p>
                <p class="theme__book-auteur">{livre.auteur}</p>
                <p class="theme__book-presentation">{livre.presentation}</p>
              </Wrapper>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .theme {
    --section-color: var(--accent-critiques);
  }

  .theme__back {
    display: inline-block;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: var(--space-4);
  }

  .theme__back:hover {
    text-decoration: underline;
  }

  .theme__banner {
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }

  .theme__banner :global(img) {
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: cover;
    display: block;
  }

  .theme__header {
    margin-bottom: var(--space-5);
  }

  .theme__header h1 {
    margin: 0;
  }

  .theme__empty {
    color: var(--color-ink-soft);
  }

  .theme__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 52px 36px;
  }

  .theme__book {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .theme__cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: contain;
    background: var(--color-card-bg);
    border-radius: 8px;
    box-shadow: 0 6px 16px rgba(41, 38, 36, 0.14);
    margin-bottom: 10px;
    transition: transform 0.2s ease;
  }

  .theme__book:hover .theme__cover {
    transform: translateY(-3px);
  }

  .theme__book-titre {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .theme__book-auteur {
    color: var(--color-ink-muted);
    font-size: 0.85rem;
    margin-top: 2px;
  }

  .theme__book-presentation {
    color: var(--color-ink-soft);
    font-size: 0.82rem;
    line-height: 1.4;
    margin-top: 6px;
  }
</style>
