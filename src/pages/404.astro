---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable · Klein Éditions" description="Cette page n'existe pas ou plus.">
  <section class="section not-found">
    <div class="container not-found__content">
      <p class="eyebrow">404</p>
      <h1>Cette page est introuvable</h1>
      <p class="not-found__text">
        Le lien suivi ne correspond à aucune page du site. Vous pouvez revenir à l'accueil ou
        choisir une rubrique dans le menu.
      </p>
      <a class="btn btn-primary" href="/">Retour à l'accueil</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .not-found__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 480px;
  }

  .not-found__text {
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>
