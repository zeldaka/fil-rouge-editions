---
import Layout from '../layouts/Layout.astro';
import Thread from '../components/Thread.astro';
import { Image } from 'astro:assets';
import audreyPhoto from '../assets/audrey-klein.png';
import { categories } from '../data/categories';
---

<Layout
  title="Audrey Klein, biographe familiale · Klein Éditions"
  description="Audrey Klein, biographe personnelle et familiale : récits de vie, mémoires et biographies familiales, en français, anglais ou espagnol."
>
  <section class="hero">
    <div class="hero__thread">
      <Thread variant="c" color="var(--accent-accueil)" />
    </div>

    <div class="container hero__grid">
      <div class="hero__text">
        {/* Le sous-titre fait partie du H1 (visuellement inchangé) : c'est
            lui qui porte le mot-clé « biographe » pour Google. */}
        <h1>
          Klein Éditions
          <span class="hero__subtitle">Biographe personnelle &amp; familiale</span>
        </h1>
        <p class="hero__tagline">« Faites de votre vie un roman ! »</p>
        <p class="hero__promesse">
          Récits de vie, mémoires, roman familial ou destin personnel : je mets en mots vos histoires.
        </p>
        <a class="btn btn-primary" href="/contact/">Parlons de votre histoire</a>
      </div>

      <div class="hero__photo">
        <Image
          src={audreyPhoto}
          alt="Audrey Klein, biographe, devant sa bibliothèque"
          width={900}
          height={1125}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* Donne à Google (et aux visiteurs) de quoi comprendre l'activité dès
      l'accueil, avec des liens vers les rubriques. Les deux paragraphes
      sont repris tels quels de la page À propos ; les titres et libellés
      de liens sont à valider par Audrey. */}
  <section class="section accueil-suite">
    <div class="container accueil-suite__grid">
      <div class="accueil-suite__bloc">
        <h2>Une plume au service des familles</h2>
        <p>
          Bercée par les mots, la littérature et la transmission des histoires de vie, j’ai décidé
          de mettre ma passion au service d’une mission et ma plume au service des familles.
        </p>
        <p>
          Après un parcours dans l'édition (Gallimard, Zulma) et la critique littéraire
          (Books'nJoy), j'accompagne aujourd’hui celles et ceux qui souhaitent préserver leur
          mémoire familiale et transmettre leur histoire aux générations futures.
        </p>
        <a class="accueil-suite__lien" href="/a-propos/">Découvrir mon parcours</a>
      </div>

      <div class="accueil-suite__bloc">
        <h2>Biographies familiales, récits de vie, mémoires</h2>
        <ul class="accueil-suite__liste">
          {categories.map((cat) => (
            <li>{cat.title}</li>
          ))}
        </ul>
        <a class="accueil-suite__lien" href="/vos-histoires/">Voir les types de projets</a>
        <a class="accueil-suite__lien" href="/les-etapes/">Les huit étapes de l'accompagnement</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    --section-color: var(--accent-accueil);
    position: relative;
    overflow: hidden;
    padding: var(--space-6) 0;
  }

  .hero h1 {
    /* Nom du site, pas un titre de rubrique : reste en encre. */
    color: var(--color-ink);
  }

  .hero__grid {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .hero__text {
    flex: 1;
    min-width: 320px;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }

  .hero__subtitle {
    display: block;
    margin-top: 18px;
    line-height: 1.6;
    font-family: var(--font-sans-alt);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 300;
    color: var(--color-ink);
  }

  .hero__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--accent-accueil);
  }

  .hero__promesse {
    font-size: 1.05rem;
    color: var(--color-ink-muted);
    max-width: 460px;
    line-height: 1.65;
  }

  .hero__photo {
    flex: 1;
    min-width: 280px;
    max-width: 560px;
  }

  .hero__photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 18px;
  }

  .hero__thread {
    position: absolute;
    inset: 10px 0;
    opacity: 0.6;
    transform: scaleX(-1);
    z-index: 0;
  }

  .accueil-suite {
    --section-color: var(--accent-accueil);
    padding-top: 0;
  }

  .accueil-suite__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .accueil-suite__bloc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .accueil-suite__bloc p,
  .accueil-suite__liste {
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .accueil-suite__liste {
    margin: 0;
    padding-left: 1.2em;
  }

  .accueil-suite__liste li::marker {
    color: var(--section-color);
  }

  /* Texte en encre (lisible), souligné à la couleur de la rubrique — même
     principe que les liens du menu. */
  .accueil-suite__lien {
    font-weight: 700;
    color: var(--color-ink);
    text-decoration-color: var(--section-color);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (max-width: 860px) {
    .accueil-suite__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
