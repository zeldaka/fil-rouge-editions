---
import Layout from '../layouts/Layout.astro';
import Thread from '../components/Thread.astro';
import { categories } from '../data/categories';
---

<Layout
  title="Biographies familiales et récits de vie · Klein Éditions"
  description="Biographies familiales, biographies personnelles, récits de vie, parcours d'immigration, récits de voyage : les types de projets accompagnés par Klein Éditions."
>
  <section class="section histoires">
    <div class="histoires__thread">
      <Thread variant="b" color="var(--accent-vos-histoires)" />
    </div>
    <div class="container">
      <h1>Vos histoires</h1>

      <div class="histoires__grid">
        {categories.map((cat, i) => (
          <div class="card histoires__card" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
            <h3>{cat.title}</h3>
            {cat.description && <p>{cat.description}</p>}
          </div>
        ))}
      </div>

      {/* Texte de mention (langues / à distance), rédigé à partir du brief section 19 —
          à valider ou reformuler par Audrey, ce n'est pas une citation littérale. */}
      <p class="histoires__note" data-reveal>
        Les projets sont menés en présentiel ou à distance, avec des personnes situées dans
        différents pays, en français, en anglais ou en espagnol.
      </p>

      <div class="histoires__cta" data-reveal>
        <a class="btn btn-primary" href="/contact/">Parlons de votre histoire</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .histoires {
    --section-color: var(--accent-vos-histoires);
    position: relative;
    overflow: hidden;
    overflow: clip; /* pas « hidden » seul : voir Thread.astro */
  }

  .histoires h1 {
    color: var(--section-color);
  }

  .histoires__thread {
    position: absolute;
    inset: 10px 0;
    opacity: 0.55;
    z-index: 0;
  }

  .histoires h1 {
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-4);
  }

  .histoires__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .histoires__card {
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }

  .histoires__card h3 {
    margin-bottom: 10px;
  }

  .histoires__card p {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .histoires__note {
    position: relative;
    z-index: 1;
    margin-top: var(--space-5);
    margin-left: auto;
    color: var(--section-color, var(--color-ink));
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    max-width: 560px;
    text-align: right;
  }

  .histoires__cta {
    position: relative;
    z-index: 1;
    margin-top: var(--space-4);
    display: flex;
    justify-content: flex-end;
  }
</style>
