---
import Layout from '../layouts/Layout.astro';
import Thread from '../components/Thread.astro';
import { categories } from '../data/categories';

const featured = categories.find((cat) => cat.title === 'Biographie romancée');
const otherCategories = categories.filter((cat) => cat.title !== 'Biographie romancée');
---

<Layout
  title="Vos histoires"
  description="Biographies familiales, biographies personnelles, récits de vie, parcours d'immigration, récits de voyage : les types de projets accompagnés par Klein Éditions."
>
  <section class="section histoires">
    <div class="histoires__thread">
      <Thread variant="b" color="var(--accent-vos-histoires)" />
    </div>
    <div class="container">
      <h1>Vos histoires</h1>

      {featured && (
        <div class="histoires__featured">
          <span class="histoires__featured-badge">✦ Ce qui nous rend unique</span>
          <h2>{featured.title}</h2>
          {featured.description && <p>{featured.description}</p>}
        </div>
      )}

      <div class="histoires__grid">
        {otherCategories.map((cat) => (
          <div class="card histoires__card">
            <h3>{cat.title}</h3>
            {cat.description && <p>{cat.description}</p>}
          </div>
        ))}
      </div>

      {/* Texte de mention (langues / à distance), rédigé à partir du brief section 19 —
          à valider ou reformuler par Audrey, ce n'est pas une citation littérale. */}
      <p class="histoires__note">
        Les projets sont menés en présentiel ou à distance, avec des personnes situées dans
        différents pays, en français, en anglais ou en espagnol.
      </p>
    </div>
  </section>
</Layout>

<style>
  .histoires {
    --section-color: var(--accent-vos-histoires);
    position: relative;
    overflow: hidden;
  }

  .histoires h1 {
    color: var(--section-color);
  }

  .histoires__thread {
    position: absolute;
    inset: 10px 0;
    opacity: 0.55;
    z-index: 0;
  }

  .histoires h1 {
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-4);
  }

  .histoires__featured {
    position: relative;
    z-index: 1;
    background: var(--color-card-bg);
    border: 1.5px solid var(--accent-accueil);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    margin-bottom: 24px;
  }

  .histoires__featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: color-mix(in srgb, var(--accent-accueil) 15%, white);
    color: var(--accent-accueil);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 14px;
  }

  .histoires__featured h2 {
    margin-bottom: 10px;
  }

  .histoires__featured p {
    color: var(--color-ink-muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 640px;
  }

  .histoires__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .histoires__card {
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }

  .histoires__card h3 {
    margin-bottom: 10px;
  }

  .histoires__card p {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .histoires__note {
    position: relative;
    z-index: 1;
    margin-top: var(--space-5);
    margin-left: auto;
    color: var(--section-color, var(--color-ink));
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    max-width: 560px;
    text-align: right;
  }
</style>
